[Unit]
Description=CreateSheets Backend - Spring Boot Application
Documentation=https://github.com/krishnaawasthi-26/Interactive-Question-Management-Sheet
After=network-online.target
Wants=network-online.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/opt/iqms-backend
ExecStart=/usr/bin/java -Xms256m -Xmx512m -Dspring.profiles.active=prod -jar /opt/iqms-backend/iqms-backend.jar
SuccessExitStatus=143
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=15
StartLimitIntervalSec=120
StartLimitBurst=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iqms-backend

[Install]
WantedBy=multi-user.target
