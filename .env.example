# Frontend Environment Variables
# File: .env (project root for Vite frontend)
# Leave empty to auto-resolve (localhost backend in local dev, same-origin in deployments).

VITE_API_BASE_URL=""
VITE_APP_API_BASE_URL=""
VITE_APP_AUTH_GOOGLE_CLIENT_ID="replace-with-google-client-id"
VITE_GOOGLE_CLIENT_ID="replace-with-google-client-id"
VITE_RAZORPAY_KEY_ID="replace-with-razorpay-key-id"
VITE_APP_NAME="Create Sheets"
VITE_ADMIN_USERNAME=CreateSheets
VITE_SITE_URL="http://localhost:3000"

# Docker Compose / backend placeholders.
# Copy this file to .env for local Docker runs and replace placeholders as needed.
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=18080
MONGODB_URI=mongodb://mongo:27017/iqms
MONGO_STARTUP_PING_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
APP_AUTH_SECRET=replace-with-a-long-random-secret
APP_AUTH_GOOGLE_CLIENT_ID=replace-with-google-client-id
APP_AUTH_GOOGLE_CLIENT_IDS=
APP_AUTH_OTP_BYPASS_KEY=
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*
ADMIN_USERNAME=CreateSheets
APP_MAIL_ENABLED=false
APP_MAIL_HOST=smtp.gmail.com
APP_MAIL_PORT=587
APP_MAIL_USERNAME=replace-with-smtp-username
APP_MAIL_PASSWORD=replace-with-smtp-password
APP_MAIL_FROM=
APP_MAIL_FROM_NAME="Create Sheets"
APP_MAIL_AUTH=true
APP_MAIL_STARTTLS=true
APP_PAYMENT_RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
APP_CACHE_PUBLIC_TTL_SECONDS=300
