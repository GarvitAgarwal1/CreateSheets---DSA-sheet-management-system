# Backend Environment Variables
# File: backend/.env

# MongoDB
MONGODB_URI=mongodb://localhost:27017/iqms

# Auth secret (use your own long random secret here)
APP_AUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth (primary or list)
APP_AUTH_GOOGLE_CLIENT_ID=replace-with-google-client-id
# APP_AUTH_GOOGLE_CLIENT_IDS="replace-with-google-client-id,replace-with-another-google-client-id"

# OTP bypass key for testing only
APP_AUTH_OTP_BYPASS_KEY=replace-with-test-only-bypass-key

# Admin account used for featured public catalog sheets
ADMIN_USERNAME=CreateSheets

# SMTP / OTP email settings
APP_MAIL_ENABLED=false
APP_MAIL_HOST=smtp.gmail.com
APP_MAIL_PORT=587
APP_MAIL_USERNAME=replace-with-smtp-username
APP_MAIL_PASSWORD=replace-with-smtp-password
# Optional; falls back to APP_MAIL_USERNAME when omitted
# APP_MAIL_FROM="replace-with-from-address"
APP_MAIL_FROM_NAME=Create Sheets
APP_MAIL_AUTH=true
APP_MAIL_STARTTLS=true

# Payments (Razorpay)
APP_PAYMENT_RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret

# Public Redis cache
APP_CACHE_PUBLIC_TTL_SECONDS=300
